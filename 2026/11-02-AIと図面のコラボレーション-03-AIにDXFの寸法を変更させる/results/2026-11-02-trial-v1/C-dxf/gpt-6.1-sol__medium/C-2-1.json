'142','143','148','149','14A','14C','14E','14F','150','151','152'}:\n  # Dimension rendering, extension lines, ticks and definition points.\n  alter(a,b,lambda c,v: ('4,550' if h=='140' else '10,920') if c==1 and h in {'140','14F'} else str(float(v)+455) if c==10 and h in {'140','14F'} else str(float(v)+910) if c in (10,11) and float(v)==10010 else v)\n elif h in {'191','192','193','194'}:\n  alter(a,b,lambda c,v: str(float(v)+455) if c in (10,11) else '約10畳' if c==1 and h=='192' else '約7.5畳' if c==1 and h=='194' else v)\n if pairs[a:b]\"'!=original[a:b]: changed.append(h)\n# Verify model geometry and unchanged protected entities before saving.\nbyhandle={val(a,b,5):(a,b) for a,b in records if val(a,b,5)}\ndef entity(h):\n a,b=byhandle[h]; return pairs[a:b]\ndef coord(h,c): return float(next(v for k,v in entity(h) if k==c))\nassert coord('\"'EA',10)-coord('E7',10)==4550\nassert coord('EA',10)==10920\nassert coord('135',14)-coord('135',13)==4550\nassert coord('144',14)-coord('144',13)==10920\nfor h in ['93','94','95','96','97','98','99','9A','9F','A0','A1','A2','A3','A4','AB','AC','AD','AE','AF','B0','B1','B2','B3','B4','B5','B6','B7','BA','BB','BC','18F','190','195','196','197','198','199']:\n a,b=byhandle[h]; assert pairs[a:b]==original[a:b],h\nfor h in walls:\n a,b=byhandle[h]\n for (c,v),(oc,ov) in zip(pairs[a:b],original[a:b]):\n  assert c==oc\n  assert (float(v)==float(ov)+910 if c==10 and float(ov)>=9935 else v==ov)\nfor h in east_windows|{'B8','B9'}:\n a,b=byhandle[h]\n for (c,v),(oc,ov) in zip(pairs[a:b],original[a:b]):\n  assert (float(v)==float(ov)+910 if c in (10,11) else v==ov)\n# Preserve every original line except changed group values.\nfor i,((c,v),(oc,ov)) in enumerate(zip(pairs,original)):\n if v\"'!=ov:\n  old=lines[2*i+1]; ending='\"'\\\\r\\\\n' if old.endswith('\\\\r\\\\n') else '\\\\n' if old.endswith('\\\\n') else ''\n  lines[2*i+1]=v+ending\nout=''.join(lines).encode('utf-8')\ncheck=out.decode('utf-8').splitlines()\nassert len(check)==len(line