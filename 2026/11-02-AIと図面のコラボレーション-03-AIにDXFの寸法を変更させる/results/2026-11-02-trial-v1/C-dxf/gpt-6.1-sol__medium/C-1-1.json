 len(changes)==5\nout=lines.copy()\nfor i,v in changes.items():\n old=out[2*i+1]; newline=b'\\\\r\\\\n' if old.endswith(b'\\\\r\\\\n') else b'\\\\n' if old.endswith(b'\\\\n') else b''\n out[2*i+1]=v.encode()+newline\nnewraw=b''.join(out)\nnewlines=newraw.splitlines(); newpairs=[(int(newlines[i]),newlines[i+1].decode('utf-8')) for i in range(0,len(newlines),2)]\nassert len(newpairs)==len(pairs)\nassert {i for i,(a,b) in enumerate(zip(pairs,newpairs)) if a\"'!=b}==set(changes)\nfor h in ['\"'C0','C1','C2']:\n start,end,e=entities[h];d=dict(newpairs[start:end]);assert float(d[11])-float(d[10])==1820\n# The wall opening meets both window edges, with wall thickness preserved.\nstart,end,e=entities['93']; vertices=[]\nfor j,(c,v) in enumerate(newpairs[start:end]):\n if c==10:vertices.append((float(v),float(newpairs[start+j+1][1])))\nassert vertices[:2]==[(5120,-75),(5120,75)]\nassert 5120<6310 # Remaining wall before the internal partition.\nassert hashlib.sha256(src.read_bytes()).hexdigest()==digest\nPath('drawing-changed.dxf').write_bytes(newraw)\nassert Path('drawing-changed.dxf').read_bytes()==newraw\nassert hashlib.sha256(src.read_bytes()).hexdigest()==digest\nprint('Saved drawing-changed.dxf; verified width 1820 mm, left edge 3300 mm, right edge 5120 mm.')\nprint('Only 5 coordinate values changed: three window endpoints and two adjoining wall vertices. Original unchanged.')\nPY\" in /private/var/folders/0x/07s29thx20lfhzwy7tv3k9x40000gn/T/drawing-eval-4r9xksap\n exited 1 in 0ms:\nTraceback (most recent call last):\n  File \"<stdin>\", line 34, in <module>\nAssertionError\n\nexec\n/bin/zsh -lc \"python - <<'PY'\nfrom pathlib import Path\nimport hashlib\nsrc=Path('drawing.dxf'); raw=src.read_bytes(); digest=hashlib.sha256(raw).hexdigest(); lines=raw.splitlines(keepends=True)\ndef parse(ls):\n assert len(ls)%2==0\n return [(int(ls[i].strip()),ls[i+1].strip().decode('utf-8')) for i in range(0,len(ls),2)]\npairs=parse(lines); starts=[i for i,p in enumerate(pairs) if p[0]