{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--userDataDir",
        "${HOME}/.cache/cdp-mcp/tried"
      ],
      "env": {}
    },
    "cities-skylines": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "code/ai-mayor/mcp",
        "server.py"
      ],
      "env": {}
    }
  }
}
