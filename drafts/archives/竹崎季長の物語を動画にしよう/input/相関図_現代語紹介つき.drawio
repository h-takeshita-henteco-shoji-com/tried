  <diagram id="suenaga-relations-comic" name="竹崎季長 人物相関図（現代語紹介つき）">
    <mxGraphModel dx="1700" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1540" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;竹崎季長 人物相関図（絵詞の図像つき・現代語紹介）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="840" height="40" as="geometry"/></mxCell>
<mxCell id="g_40_90" value="季長の身内・郎党" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#9fb3d1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontColor=#3b5a86;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="680" height="380" as="geometry"/></mxCell>
<mxCell id="g_1020_90" value="文永（ぶんえい）の役（1274・博多＝今の福岡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#9fb3d1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontColor=#3b5a86;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="680" height="380" as="geometry"/></mxCell>
<mxCell id="g_40_590" value="鎌倉（直訴）＝今の神奈川県鎌倉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#9fb3d1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontColor=#3b5a86;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="680" height="380" as="geometry"/></mxCell>
<mxCell id="g_1020_590" value="弘安（こうあん）の役（1281・博多湾＝今の福岡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#9fb3d1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontColor=#3b5a86;" vertex="1" parent="1"><mxGeometry x="1020" y="590" width="680" height="380" as="geometry"/></mxCell>
<mxCell id="g_600_1090" value="晩年・絵詞（1293年ごろ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#9fb3d1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontColor=#3b5a86;" vertex="1" parent="1"><mxGeometry x="600" y="1090" width="520" height="380" as="geometry"/></mxCell>
<mxCell id="suenaga" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9a8;strokeColor=#b8860b;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="240" height="380" as="geometry"/></mxCell>
<mxCell id="suenaga_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="758" y="568" width="224" height="186" as="geometry"/></mxCell>
<mxCell id="suenaga_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;竹崎季長&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（たけざき すえなが）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;主人公・語り手&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="754" y="756" width="232" height="52" as="geometry"/></mxCell>
<mxCell id="suenaga_desc" value="肥後（今の熊本）の田舎御家人。家は親族ゲンカで没落済み。口ぐせは「先に行ったもん勝ち」。評価されないと鎌倉まで直談判しに行くタイプ。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="758" y="808" width="224" height="126" as="geometry"/></mxCell>
<mxCell id="sukemitsu" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="sukemitsu_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="68" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="sukemitsu_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;藤源太資光&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（とうげんた すけみつ）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;旗指（はたさし）・相棒&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="sukemitsu_desc" value="季長の旗持ち係。「また勝手に突っ込むんですか」と言いつつ、必ずついていく苦労人。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="68" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="mitsui" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="mitsui_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="288" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="mitsui_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;三井資長&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（みつい すけなが）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;縁者（五騎の一人）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="284" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="mitsui_desc" value="季長の身内。現実派で、無謀な作戦には渋い顔。でも結局いっしょに出陣する。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="288" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="sister" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="sister_ph" value="絵詞に図像なし&lt;br&gt;（別途用意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;dashed=1;fontColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="508" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="sister_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;季長の姉&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（すえながのあね）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;（脚色）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="504" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="sister_desc" value="没落した家の実質的な司令塔。鎌倉行きの旅費は、たぶんこの人が工面した。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="508" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="kikuchi" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="kikuchi_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1048" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="kikuchi_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;菊池武房&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（きくち たけふさ）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;先駆けの目撃者&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1044" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="kikuchi_desc" value="肥後（今の熊本）の大物御家人。寡黙だが「あいつが最初だった」の一言で季長の人生を救う。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1048" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="shiraishi" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="shiraishi_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1268" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="shiraishi_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;白石通泰&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（しらいし みちやす）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;救援した御家人&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1264" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="shiraishi_desc" value="肥前（今の佐賀・長崎）から百騎を率いて颯爽と登場し、瀕死の季長を回収。「あと少し遅かったら…」の係。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1268" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="shoni" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="shoni_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1488" y="148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="shoni_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;少弐景資&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（しょうに かげすけ）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;総大将&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1484" y="303" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="shoni_desc" value="現場の総大将で超多忙。季長の「先駆けしていいすか」に「好きにしろ」と返した人。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1488" y="355" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="yasumori" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#3c763d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="yasumori_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="68" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="yasumori_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;安達泰盛&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（あだち やすもり）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;御恩奉行（ごおんぶぎょう）・恩人&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="yasumori_desc" value="鎌倉（今の神奈川県鎌倉）の人事部長。威圧感はあるが公平。「証人は？」の一言で全部を決める。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="68" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="tokimune" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="tokimune_ph" value="絵詞に図像なし&lt;br&gt;（別途用意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;dashed=1;fontColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="288" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="tokimune_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;北条時宗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（ほうじょう ときむね）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;執権（しっけん・名前のみ）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="284" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="tokimune_desc" value="幕府のトップ。季長からは遠すぎて、名前しか出てこない雲の上の人。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="288" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="official" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="official_ph" value="絵詞に図像なし&lt;br&gt;（別途用意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;dashed=1;fontColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="508" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="official_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;侍所の役人&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（さむらいどころのやくにん）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;（脚色）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="504" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="official_desc" value="鎌倉（今の神奈川県鎌倉）の受付担当。「田舎の無足が何の用だ」と季長を三日間門前払い。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="508" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="kono" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="kono_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1048" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="kono_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;河野通有&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（こうの みちあり）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;伊予（今の愛媛）の御家人・盟友&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1044" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="kono_desc" value="伊予（今の愛媛）の豪快な御家人。負傷しても陽気。「生きて帰ったら飲もう」と約束する相手。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1048" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="oyano" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="oyano_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1268" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="oyano_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;大矢野兄弟&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（おおやの きょうだい）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;種保（たねやす）・種村（たねむら）（天草＝今の熊本県天草）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1264" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="oyano_desc" value="天草（今の熊本県天草）の兄弟。船を探す季長を「うちの船に乗れよ」と拾ってくれた命の恩人。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1268" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="morimune" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#3c763d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="640" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="morimune_img" value="" style="shape=image;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1488" y="648" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="morimune_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;安達盛宗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（あだち もりむね）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;泰盛の子&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1484" y="803" width="192" height="52" as="geometry"/></mxCell>
<mxCell id="morimune_desc" value="泰盛の息子で九州（現場は博多＝今の福岡）担当。季長が取った首をちゃんと記録してくれる、話のわかる上司。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1488" y="855" width="184" height="79" as="geometry"/></mxCell>
<mxCell id="painter" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1140" width="200" height="300" as="geometry"/></mxCell>
<mxCell id="painter_ph" value="絵詞に図像なし&lt;br&gt;（別途用意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;dashed=1;fontColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="648" y="1148" width="184" height="153" as="geometry"/></mxCell>
<mxCell id="painter_name" value="&lt;b style=&quot;font-size:15px&quot;&gt;絵師&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#777&quot;&gt;（えし）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;（脚色）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="644" y="1303" width="192" height="52" as="geometry"/></mxCell>
