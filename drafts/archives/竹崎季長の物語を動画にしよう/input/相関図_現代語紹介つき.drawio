<mxCell id="kosa_desc" value="季長の氏神さま（甲佐＝今の熊本県甲佐町）。完成した絵巻を納めてもらう、物語の終着点。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="908" y="1355" width="184" height="79" as="geometry"/></mxCell>
