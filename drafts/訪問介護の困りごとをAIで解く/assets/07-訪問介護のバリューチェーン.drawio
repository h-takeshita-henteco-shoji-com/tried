;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H3" target="H4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H4" target="U2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="U3" target="H5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H4" target="H5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H5" target="H6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="報告" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="H5" target="S4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="H6" target="H7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="状態の変化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.3;entryX=0.5;entryY=0;" edge="1" parent="1" source="S4" target="C2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="相談" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="S4" target="M1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="訪問の実績" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="H7" target="M2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_seam" value="行政指導から&lt;br&gt;見たペイン(P)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1250" width="140" height="46" as="geometry"/></mxCell><mxCell id="legend_field" value="現場の&lt;br&gt;ペイン(H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1306" width="140" height="46" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;この流れのペイン&lt;/b&gt;&lt;br&gt;・H2 シフトが崩れる: キャンセルや欠勤のたびに、サ責が代わりを探し、連絡し直す&lt;br&gt;・P1 計画の直し忘れ: 当日の変更がケアマネや計画に伝わらないと、計画にない提供になる&lt;br&gt;・H3 移動・待機が報われない: 移動は介護報酬の対象外。賃金の扱いを誤ると未払いになる&lt;br&gt;・H4 ハラスメント: 1人で家に入る。原因で最も多いのは「サービスの範囲が伝わっていない」&lt;br&gt;・H5 情報が届きにくい: 直行直帰で、状態の変化がサ責やケアマネに届くのが遅れる&lt;br&gt;・P2 記録: 訪問の合間に書くため、要件が欠けやすい" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1250" width="831" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow4" name="流れ4 人を採って育てる"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="流れ4: 人を採って育てる(求人から、定着まで)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="ph0" value="採る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="122" width="110" height="396" as="geometry"/></mxCell><mxCell id="ph1" value="迎える" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="110" height="96" as="geometry"/></mxCell><mxCell id="ph2" value="育てる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="622" width="110" height="296" as="geometry"/></mxCell><mxCell id="ph3" value="続けてもらう" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="922" width="110" height="196" as="geometry"/></mxCell><mxCell id="lane_E" value="経営者" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="136" y="70" width="175" height="1060" as="geometry"/></mxCell><mxCell id="lane_A" value="管理者・総務" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="311" y="70" width="175" height="1060" as="geometry"/></mxCell><mxCell id="lane_S" value="サービス&lt;br&gt;提供責任者" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="486" y="70" width="175" height=