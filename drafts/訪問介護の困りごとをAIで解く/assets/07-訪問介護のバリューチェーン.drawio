1" parent="1"><mxGeometry x="220" y="175" width="170" height="135" as="geometry"/></mxCell><mxCell id="p2" value="訪問" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="85" width="200" height="80" as="geometry"/></mxCell><mxCell id="pw2" value="&lt;b&gt;担い手&lt;/b&gt;&lt;br&gt;ヘルパー&lt;br&gt;&lt;br&gt;&lt;b&gt;継ぎ目の書類&lt;/b&gt;&lt;br&gt;訪問スケジュール&lt;br&gt;&lt;br&gt;&lt;b&gt;ペイン&lt;/b&gt; H2、H3、H4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="410" y="175" width="170" height="135" as="geometry"/></mxCell><mxCell id="p3" value="記録" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="85" width="200" height="80" as="geometry"/></mxCell><mxCell id="pw3" value="&lt;b&gt;担い手&lt;/b&gt;&lt;br&gt;ヘルパー、サ責&lt;br&gt;&lt;br&gt;&lt;b&gt;継ぎ目の書類&lt;/b&gt;&lt;br&gt;サービス提供記録&lt;br&gt;&lt;br&gt;&lt;b&gt;ペイン&lt;/b&gt; P2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600" y="175" width="170" height="135" as="geometry"/></mxCell><mxCell id="p4" value="請求・回収" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="85" width="200" height="80" as="geometry"/></mxCell><mxCell id="pw4" value="&lt;b&gt;担い手&lt;/b&gt;&lt;br&gt;請求事務、ケアマネ&lt;br&gt;&lt;br&gt;&lt;b&gt;継ぎ目の書類&lt;/b&gt;&lt;br&gt;提供票、実績、&lt;br&gt;請求明細、給付管理票&lt;br&gt;&lt;br&gt;&lt;b&gt;ペイン&lt;/b&gt; P3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ccccc