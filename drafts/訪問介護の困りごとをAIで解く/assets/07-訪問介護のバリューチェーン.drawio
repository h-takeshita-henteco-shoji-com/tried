kgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="S3" target="H1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="S4" target="H1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_seam" value="行政指導から&lt;br&gt;見たペイン(P)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1250" width="140" height="46" as="geometry"/></mxCell><mxCell id="legend_field" value="現場の&lt;br&gt;ペイン(H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1306" width="140" height="46" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;この流れのペイン&lt;/b&gt;&lt;br&gt;・P1 計画の連鎖がずれる: ケアプラン → 訪問介護計画 → 手順書が食い違う。同意の日付が提供開始より後になる&lt;br&gt;・H1・H2 人が足りない: サ責とヘルパーの空きがなく、受け入れを断る&lt;br&gt;・H4 サービスの範囲が伝わらない: 契約時の説明が、のちの範囲外の頼みごとやハラスメントの遠因になる" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1250" width="1006" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow2" name="流れ2 毎月のサイクル"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="流れ2: 毎月のサイクル(提供票が届いてから、報酬が入るまで)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="ph0" value="前月末" style="rounded=0;whiteSpace=wrap;html=1;fil