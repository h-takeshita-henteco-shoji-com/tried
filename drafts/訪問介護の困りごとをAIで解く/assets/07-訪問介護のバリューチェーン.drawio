444;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="A1" target="N1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="N1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="A3" target="S1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="S1" target="N2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="N2" target="N3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="手順書" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="S2" target="N3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="A4" target="N4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="N3" target="N4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="N4" target="N5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="辞める" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="N5" target="A5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="求人に戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;dashed=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="A5" target="A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_seam" value="行政指導から&lt;br&gt;見たペイン(P)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="140" height="46" as="geometry"/></mxCell><mxCell id="legend_field" value="現場の&lt;br&gt;ペイン(H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1206" width="140" height="46" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;この流れのペイン&lt;/b&gt;&lt;br&gt;・H1 人が採れない: 訪問介護職員の有効求人倍率は15.53倍(2022年度)。60歳以上が25.7%で、30歳未満は6.1%&lt;br&gt;・P4 資格と人員基準: 資格証や勤務表が、人員基準の証跡になる&lt;br&gt;・H5 育成が難しい: 直行直帰で、教える機会が同行訪問に限られる&lt;br&gt;・P5 研修: 義務の研修が抜けると、減算や指摘の対象になる&lt;br&gt;・辞める理由(収入の不安定さ、移動、ハラスメント)が、H1をさらに悪くする" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1150" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow5" name="流れ5 体制と運営指導"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="流れ5: 体制と運営指導(改定から、返還まで)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="ph0" value="改定と方針" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="122" width="110" height="296" as="geometry"/></mxCell><mxCell id="ph1" value="届出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="110" height="96" as="geometry"/></mxCell><mxCell id="ph2" value="日々と年次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="110" height="296" as="geometry"/></mxCell><mxCell id="ph3" value="運営指導" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="822" width="110" height="496" as="geometry"/></mxCell><mxCell id="lane_E" value="経営者" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="136" y="70" width="175" height="1260" as="geometry"/></mxCell><mxCell id="lane_M" value="管理者" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="311" y="70" width="175" height="1260" as="geometry"/></mxCell><mxCell id="lane_O" value="総務・経理" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="486" y="70" width="175" height="1260" as="geometry"/></mxCell><mxCell id="lane_K" value="行政&lt;br&gt;(参考)" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#eeeeee;strokeColor=#aaaaaa;fontSize=13;fontStyle=1;fontColor=#666666;swimlaneFillColor=#fafafa;dashed=1;" vertex="1" parent="1"><mxGeometry x="661" y="70" width="175" height="1260" as="geometry"/></mxCell><mxCell id="K0" value="改定・通知・&lt;br&gt;Q&amp;Aを出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;dashed=1;" vertex="1" parent="lane_K"><mxGeometry x="15" y="69" width="145" height="62" as="geometry"/></mxCell><mxCell id="M0" value="改定を読み、&lt;br&gt;影響を調べる【P7】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="169" width="145" height="62" as="geometry"/></mxCell><mxCell id="E1" value="取る加算と&lt;br&gt;体制を決める【P8】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_E"><mxGeometry x="15" y="269" width="145" height="62" as="geometry"/></mxCell><mxCell id="M1" value="体制届を出す&lt;br&gt;(電子申請)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="369" width="145" height="62" as="geometry"/></mxCell><mxCell id="K1" value="届出を受け付ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;dashed=1;" vertex="1" parent="lane_K"><mxGeometry x="15" y="369" width="145" height="62" as="geometry"/></mxCell><mxCell id="M2" value="委員会・研修・指針・&lt;br&gt;BCPを回す【P5】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="469" width="145" height="62" as="geometry"/></mxCell><mxCell id="O1" value="勤務表と出勤簿を&lt;br&gt;保つ【P4】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_O"><mxGeometry x="15" y="469" width="145" height="62" as="geometry"/></mxCell><mxCell id="O2" value="処遇改善の計画書を出し、&lt;br&gt;賃金を改善する【P6】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_O"><mxGeometry x="15" y="569" width="145" height="62" as="geometry"/></mxCell><mxCell id="O3" value="処遇改善の&lt;br&gt;実績報告を出す【P6】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_O"><mxGeometry x="15" y="669" width="145" height="62" as="geometry"/></mxCell><mxCell id="K2" value="運営指導を&lt;br&gt;通知する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;dashed=1;" vertex="1" parent="lane_K"><mxGeometry x="15" y="769" width="145" height="62" as="geometry"/></mxCell><mxCell id="M3" value="自己点検し、&lt;br&gt;確認文書をそろえる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="869" width="145" height="62" as="geometry"/></mxCell><mxCell id="O4" value="書類を集める" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_O"><mxGeometry x="15" y="869" width="145" height="62" as="geometry"/></mxCell><mxCell id="K3" value="運営指導をする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;dashed=1;" vertex="1" parent="lane_K"><mxGeometry x="15" y="969" width="145" height="62" as="geometry"/></mxCell><mxCell id="M4" value="指摘に&lt;br&gt;改善を報告する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="1069" width="145" height="62" as="geometry"/></mxCell><mxCell id="K4" value="返還を求める&lt;br&gt;(さかのぼって)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;dashed=1;" vertex="1" parent="lane_K"><mxGeometry x="15" y="1069" width="145" height="62" as="geometry"/></mxCell><mxCell id="O5" value="返還を処理する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_O"><mxGeometry x="15" y="1169" width="145" height="62" as="geometry"/></mxCell><mxCell id="E2" value="収支を見て、&lt;br&gt;体制を見直す【H6】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_E"><mxGeometry x="15" y="1169" width="145" height="62" as="geometry"/></mxCell><mxCell id="e0" value="改定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="K0" target="M0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="M0" target="E1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="E1" target="M1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="体制届" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="M1" target="K1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="M1" target="M2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=1;exitY=0.7;entryX=0.5;entryY=0;" edge="1" parent="1" source="M1" target="O1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="O1" target="O2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="O2" target="O3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="日々の証跡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="M2" target="M3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="O3" target="O4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="通知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0;exitY=0.5;entryX=0.8;entryY=0;" edge="1" parent="1" source="K2" target="M3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="O4" target="M3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="提出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="M3" target="K3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="指摘" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="K3" target="M4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;" edge="1" parent="1" source="K3" target="K4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="返還" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="K4" target="O5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="損失" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#444444;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="O5" target="E2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_seam" value="行政指導から&lt;br&gt;見たペイン(P)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1350" width="140" height="46" as="geometry"/></mxCell><mxCell id="legend_field" value="現場の&lt;br&gt;ペイン(H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1406" width="140" height="46" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;この流れのペイン&lt;/b&gt;&lt;br&gt;・P7 改定に追いつけない: 告示・通知・Q&amp;A・自治体の通知に分散し、改定のたびに増える&lt;br&gt;・P8・H6 判断材料がない、売上が読めない: 加算の損得と収支の見通しが立たない。訪問介護の倒産は2025年に91件&lt;br&gt;・P4・P5 ソフトの外の証跡: 勤務表、委員会、研修、指針、BCPは介護ソフトの外にある&lt;br&gt;・P6 処遇改善加算: 計画書と賃金の実績が合わないと返還になる。要件は毎年のように変わる&lt;br&gt;・時間の境界: 証跡は日々たまるが、点検は運営指導のときだけ。返還はさかのぼる&lt;br&gt;行政(厚労省・自治体)はステークホルダーから除いた。流れの相手として、参考に置いた。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1350" width="700" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>