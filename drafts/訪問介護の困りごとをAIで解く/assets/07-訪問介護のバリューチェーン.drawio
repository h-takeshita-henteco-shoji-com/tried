geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow1" name="流れ1 利用を始める"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="流れ1: 利用を始める(相談から初回の訪問まで)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="ph0" value="相談" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="122" width="110" height="196" as="geometry"/></mxCell><mxCell id="ph1" value="ケアプランを作る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="322" width="110" height="296" as="geometry"/></mxCell><mxCell id="ph2" value="契約と計画" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="622" width="110" height="396" as="geometry"/></mxCell><mxCell id="ph3" value="訪問の開始" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1022" width="110" height="196" as="geometry"/></mxCell><mxCell id="lane_U" value="利用者・家族" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="136" y="70" width="175" height="1160" as="geometry"/></mxCell><mxCell id="lane_C" value="居宅の&lt;br&gt;ケアマネジャー" style="swimlane;horizontal=1;startSize=50;html=1;fillColor=#f8f8f8;strokeColor=#888888;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="311" y="70" width="175" height="1160" as="geometry