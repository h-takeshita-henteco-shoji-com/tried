69" width="145" height="62" as="geometry"/></mxCell><mxCell id="H5" value="断って説明し、&lt;br&gt;サ責に報告する【H4】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_H"><mxGeometry x="15" y="669" width="145" height="62" as="geometry"/></mxCell><mxCell id="H6" value="記録を書く【P2】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_H"><mxGeometry x="15" y="769" width="145" height="62" as="geometry"/></mxCell><mxCell id="S4" value="報告を受け、&lt;br&gt;状態の変化を伝える【H5】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_S"><mxGeometry x="15" y="769" width="145" height="62" as="geometry"/></mxCell><mxCell id="H7" value="次の家へ移動する、&lt;br&gt;または待つ【H3】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_H"><mxGeometry x="15" y="869" width="145" height="62" as="geometry"/></mxCell><mxCell id="C2" value="状態の変化を受け、&lt;br&gt;ケアプランを見直す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane_C"><mxGeometry x="15" y="869" width="145" height="62" as="geometry"/></mxCell><mxCell id="M1" value="ハラスメントに対応する&lt;br&gt;(複数人訪問・契約の見直し)【H4】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="969" width="145" height="62" as="geometry"/></mxCell><mxCell id="M2" value="移動・待機を含めて&lt;br&gt;労働時間と賃金を出す【H3】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#E07000;strokeWidth=3;fontSize=12;" vertex="1" parent="lane_M"><mxGeometry x="15" y="1069" width="145" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fon